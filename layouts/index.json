{{- $items := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
  {{- $item := dict
    "title" .Title
    "url" .RelPermalink
    "date" (.Date.Format "2006-01-02")
    "summary" (.Summary | plainify)
    "tags" (.Params.tags | default slice)
    "content" (.Plain | truncate 500)
  -}}
  {{- $items = $items | append $item -}}
{{- end -}}
{{- $items | jsonify -}}
