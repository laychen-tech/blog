[Unit]
Description=AI Revolution Control Deck
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/opt/ai-blog/server
EnvironmentFile=/opt/ai-blog/server/.env
ExecStart=/usr/bin/node /opt/ai-blog/server/src/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ai-blog /opt/ai-blog-data /opt/ai-blog-preview

[Install]
WantedBy=multi-user.target
