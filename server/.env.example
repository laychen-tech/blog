# AI 革命 · 控制台服务端配置
# 复制为 server/.env 后填写；该文件不会被提交到 Git。

NODE_ENV=production
HOST=127.0.0.1
PORT=8787

# 仓库与运行数据（生产环境建议放在仓库目录之外）
REPO_DIR=/opt/ai-blog
DATA_DIR=/opt/ai-blog-data
RELEASES_DIR=/opt/ai-blog-preview
HUGO_BIN=/usr/local/bin/hugo

# 首次启动时用于创建管理密码，创建成功后可留空
ADMIN_INITIAL_PASSWORD=please-change-me

# 必填：至少 32 字节的随机值，生成方式：openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# 公开地址
PUBLIC_SITE_URL=https://laychen-tech.github.io/blog/
ADMIN_PUBLIC_URL=https://47-117-122-253.sslip.io
PREVIEW_BASE_URL=https://47-117-122-253.sslip.io/preview/

# Git 发布
GITHUB_REPO=laychen-tech/blog
GIT_BRANCH=main
GIT_REMOTE=origin
GIT_USER_NAME=Gavin Chen
GIT_USER_EMAIL=laihub@163.com

SITE_TIME_ZONE=Asia/Shanghai
